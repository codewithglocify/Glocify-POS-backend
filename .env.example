# Copy to .env and fill in your PostgreSQL credentials.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pos?schema=public"

# JWT access tokens (issued and verified by @nestjs/authentication)
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_ISSUER="https://core.pos.test"
JWT_AUDIENCE="pos-terminal"
JWT_TTL="1h"
