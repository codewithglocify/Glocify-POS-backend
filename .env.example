# Copy to .env and fill in your PostgreSQL credentials.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pos?schema=public"

# Node environment
NODE_ENV=development

# Comma-separated browser origins allowed in production (required when NODE_ENV=production)
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# JWT access tokens (issued and verified by @nestjs/authentication)
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_ISSUER="https://core.pos.test"
JWT_AUDIENCE="pos-terminal"
JWT_TTL="1h"

# Ngrok configuration (if running inside development environment; locally...)
NGROK_AUTHTOKEN=your_ngrok_token
NGROK_FORWARD_DOMAIN=your_ngrok_domain
